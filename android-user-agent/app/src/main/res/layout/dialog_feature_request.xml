<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="20dp">

    <!-- 상단 핸들 바 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#334155"
        android:layout_marginBottom="16dp" />

    <!-- 타이틀 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💡 맞춤 기능 제작 의뢰"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_version"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="chachogreat@gmail.com"
            android:textColor="#38BDF8"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="사장님 업무에 딱 맞는 자동화 카드를 직접 제작해 드립니다. 내용을 남겨주시면 검토 후 신속히 연락드립니다."
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:layout_marginBottom="14dp" />

    <!-- 입력 1: 희망 기능 이름 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📌 희망 기능 이름 *"
        android:textColor="#E2E8F0"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etReqTitle"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="#1E293B"
        android:paddingHorizontal="10dp"
        android:hint="예: 전자세금계산서 발행, 매장 실시간 재고 관리"
        android:textColorHint="#64748B"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:singleLine="true"
        android:layout_marginBottom="12dp" />

    <!-- 입력 2: 세부 내용 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📝 필요한 자동화 내용 / 연동 시나리오 *"
        android:textColor="#E2E8F0"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etReqDesc"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#1E293B"
        android:padding="10dp"
        android:hint="어떤 상황에서 어떤 데이터가 구글 시트에 기록되거나 처리되어야 하는지 편하게 적어주세요."
        android:textColorHint="#64748B"
        android:textColor="#FFFFFF"
        android:textSize="11.5sp"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:layout_marginBottom="12dp" />

    <!-- 입력 3: 사장님 연락처 / 이메일 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📞 답변 받으실 연락처 또는 이메일 *"
        android:textColor="#E2E8F0"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etReqContact"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="#1E293B"
        android:paddingHorizontal="10dp"
        android:hint="전화번호 또는 이메일 주소"
        android:textColorHint="#64748B"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:singleLine="true"
        android:layout_marginBottom="16dp" />

    <!-- 전송 버튼 -->
    <Button
        android:id="@+id/btnSubmitRequest"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:backgroundTint="#0284C7"
        android:text="📩 의뢰서 전송하기 (Gmail/이메일 직결)"
        android:textColor="#FFFFFF"
        android:textSize="12.5sp"
        android:textStyle="bold" />

</LinearLayout>
