<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 헤더 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SheetBot Agent"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_version"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="v1.7"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 실시간 상태 카드 -->
        <LinearLayout
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_card_unpaired"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ 미연동 상태"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="시트봇 워크스페이스의 QR코드를 스캔하여 계정을 연동해 주세요."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- 실시간 서버 통신 & 오프라인 대기열 관제 패널 (연동 시 상시 노출) -->
        <LinearLayout
            android:id="@+id/layoutServerMonitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginBottom="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvServerStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌐 서버 통신: 🟢 정상 가동 (sheetbot.cloud)"
                    android:textColor="#E2E8F0"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRefreshServerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:backgroundTint="#334155"
                    android:text="🔄 재점검"
                    android:textColor="#38BDF8"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPendingDepositQueue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📥 오프라인 안전 대기열: 0건 보관 중"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 자연어 AI 시트 코파일럿 제어 센터 (v1.7 NEW) -->
        <LinearLayout
            android:id="@+id/layoutAiCopilot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎙️ 자연어 AI 시트 코파일럿"
                    android:textColor="#38BDF8"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_version"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="v1.7"
                    android:textColor="#10B981"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="말 한마디로 구글 시트의 함수(Apps Script)를 실행하고 문자 발송이나 정산을 자동 지시합니다."
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etAiCommand"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="#0F172A"
                android:paddingHorizontal="10dp"
                android:hint="예: 홍길동 고객에게 결제 안내 문자 보내줘, 이번 달 정산해줘"
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnVoiceCommand"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:backgroundTint="#8B5CF6"
                    android:text="🎙️ 음성 입력"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnExecuteCommand"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.3"
                    android:backgroundTint="#4F46E5"
                    android:text="🚀 시트 원격 실행"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- 실행 결과 피드백 브리핑 카드 -->
            <LinearLayout
                android:id="@+id/layoutAiCommandResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0F172A"
                android:padding="10dp"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvAiCommandExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#10B981"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAiCommandSpoken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 금융사 앱 푸시 감지 권한 허용 안내 버튼 (Phase 2) -->
        <Button
            android:id="@+id/btnNotificationPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#8B5CF6"
            android:text="🔔 금융사 앱 푸시 감지 권한 허용 (0원 통지)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 배터리 최적화 경고 버튼 -->
        <Button
            android:id="@+id/btnBatteryOpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#F59E0B"
            android:text="🔋 백그라운드 꺼짐 방지 설정 (배터리 제한 없음)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 로딩 프로그레스바 -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="8dp"
            android:visibility="gone" />

        <!-- 미연동 시 컨트롤 (QR 스캔 & 핀코드 입력) -->
        <LinearLayout
            android:id="@+id/layoutUnpairedControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnScanQr"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#4F46E5"
                android:text="📷 워크스페이스 QR코드 스캔 (0초 연동)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnManualPin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#1E293B"
                android:text="🔢 6자리 핀코드로 직접 연동"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 연동 완료 시 컨트롤 (대기열 수동 동기화 & 연동 해제) -->
        <LinearLayout
            android:id="@+id/layoutPairedControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnSyncPendingDeposits"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:backgroundTint="#1E293B"
                android:text="📥 오프라인 대기열 서버 즉시 전송"
                android:textColor="#38BDF8"
                android:textSize="12.5sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnUnlink"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="#334155"
                android:text="연동 해제"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Phase 1 & 2: 스마트 편의 제어 패널 (TTS 음성 & 영수증 SMS & 앱푸시 감지 & 원클릭 업데이트) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ 스마트 편의 설정"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔊 실시간 TTS 음성 안내"
                    android:textColor="#E2E8F0"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchTts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📲 0원 영수증 SMS 자동 회신"
                    android:textColor="#E2E8F0"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchReceiptSms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔔 금융사 앱 무료 푸시 실시간 감지"
                    android:textColor="#E2E8F0"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchPushDetection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSyncPendingReceipts"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:backgroundTint="#0284C7"
                android:text="📤 미발송 영수증 즉시 발송"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- 통화 녹음 구글 드라이브 자동 백업 섹션 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#334155"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎙️ 통화 녹음 드라이브 자동 백업"
                    android:textColor="#E2E8F0"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchCallRecording"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutCallRecordingSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0F172A"
                android:padding="10dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 업로드 대상 번호/이름 (쉼표 구분, 빈칸은 전체):"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etRecordingTargetFilter"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="#1E293B"
                    android:paddingHorizontal="10dp"
                    android:hint="예: 010-7523-5071, 홍길동, 거래처"
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📁 구글 드라이브 저장 폴더명:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etRecordingDriveFolder"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="#1E293B"
                    android:paddingHorizontal="10dp"
                    android:hint="[SheetBot] 통화 녹음"
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📊 [SheetBot] 통화 녹음 대장 시트 자동 기록"
                        android:textColor="#CBD5E1"
                        android:textSize="11sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchRecordingSheet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSaveRecordingSettings"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:backgroundTint="#4F46E5"
                    android:text="💾 통화 녹음 백업 설정 저장"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:layout_marginBottom="4dp" />

                <Button
                    android:id="@+id/btnSyncRecordingsNow"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:backgroundTint="#059669"
                    android:text="⚡ 지금 새 녹음 파일 즉시 동기화"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- 사진 및 파일 구글 드라이브 업로드 섹션 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#334155"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📁 사진 &amp; 문서 구글 드라이브 보관"
                    android:textColor="#E2E8F0"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_version"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="NEW"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPickAndUploadFile"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="#4F46E5"
                android:text="📷/📁 사진 &amp; 문서 파일 직접 선택하여 업로드"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- AI OCR 비즈니스 원터치 자동화 버튼 2종 (v1.5) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnPickReceipt"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:backgroundTint="#059669"
                    android:text="🧾 영수증 AI 장부"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnPickBusinessCard"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:backgroundTint="#2563EB"
                    android:text="🪪 명함 AI 인맥"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutFileUploadSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0F172A"
                android:padding="10dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📁 구글 드라이브 저장 폴더명:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etFileUploadDriveFolder"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="#1E293B"
                    android:paddingHorizontal="10dp"
                    android:hint="[SheetBot] 파일 보관함"
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📊 [SheetBot] 파일 업로드 대장 시트 자동 기록"
                        android:textColor="#CBD5E1"
                        android:textSize="11sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchFileUploadSheet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSaveFileUploadSettings"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:backgroundTint="#334155"
                    android:text="💾 파일 업로드 설정 저장"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 팁: 갤러리 또는 파일 앱에서 사진/파일을 누르고 [공유] ➡️ [SheetBot Agent]를 선택하면 앱을 열지 않아도 1초 만에 구글 드라이브로 자동 업로드됩니다."
                    android:textColor="#64748B"
                    android:textSize="10.5sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- 스마트폰 문자(SMS/LMS) 송수신 구글 시트 자동 기록 섹션 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#334155"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💬 문자(SMS) 송수신 시트 자동 기록"
                    android:textColor="#E2E8F0"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSmsSync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSmsSyncSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0F172A"
                android:padding="10dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 기록 대상 번호/이름 (쉼표 구분, 빈칸은 전체):"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etSmsTargetFilter"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="#1E293B"
                    android:paddingHorizontal="10dp"
                    android:hint="예: 010-7523-5071, 홍길동, 거래처"
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 구글 스프레드시트 대장명:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etSmsDriveSheet"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="#1E293B"
                    android:paddingHorizontal="10dp"
                    android:hint="[SheetBot] 스마트폰 문자(SMS) 송수신 대장"
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnSaveSmsSettings"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:backgroundTint="#334155"
                    android:text="💾 문자 시트 동기화 설정 저장"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- 카카오톡 수신 메시지 구글 시트 자동 기록 섹션 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#334155"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🟡 카카오톡 메시지 시트 자동 기록"
                    android:textColor="#FEE500"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchKakaoSync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutKakaoSyncSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0F172A"
                android:padding="10dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 기록 대상 채팅방/발신자 (쉼표 구분, 빈칸은 전체):"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etKakaoTargetFilter"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="#1E293B"
                    android:paddingHorizontal="10dp"
                    android:hint="예: [주문방], 거래처, 고객상담, 홍길동"
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 구글 스프레드시트 대장명:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etKakaoDriveSheet"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="#1E293B"
                    android:paddingHorizontal="10dp"
                    android:hint="[SheetBot] 카카오톡 메시지 대장"
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnSaveKakaoSettings"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:backgroundTint="#334155"
                    android:text="💾 카카오톡 시트 동기화 설정 저장"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- 부재중 전화(Missed Call) 0원 스마트 자동 회신 섹션 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#334155"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📞 부재중 전화 0원 스마트 자동 회신"
                    android:textColor="#F97316"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchMissedCall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutMissedCallSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0F172A"
                android:padding="10dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 부재중 전화 자동 회신 안내 문자:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etMissedCallReply"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="#1E293B"
                    android:padding="8dp"
                    android:gravity="top|start"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 구글 스프레드시트 대장명:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etMissedCallSheet"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="#1E293B"
                    android:paddingHorizontal="10dp"
                    android:hint="[SheetBot] 부재중 전화 대장"
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnSaveMissedCallSettings"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:backgroundTint="#334155"
                    android:text="💾 부재중 자동 회신 설정 저장"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- 통화 종료 직후 모바일 명함 원터치 발송 섹션 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#334155"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💼 통화 종료 직후 모바일 명함 발송"
                    android:textColor="#38BDF8"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchCallEndedCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutCallEndedCardSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0F172A"
                android:padding="10dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🪪 모바일 명함 / 회사 소개 문자 내용:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etBusinessCardSms"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:background="#1E293B"
                    android:padding="8dp"
                    android:gravity="top|start"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnSaveBusinessCardSettings"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:backgroundTint="#334155"
                    android:text="💾 모바일 명함 내용 저장"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCheckUpdate"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:backgroundTint="#475569"
                android:text="🔄 최신 업데이트 확인 (원클릭 덮어쓰기)"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEnterAod"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:backgroundTint="#0F172A"
                android:text="🌙 올웨이즈 블랙 모드 (화면 번인 방지)"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 최근 감지된 입금 내역 요약 -->
        <LinearLayout
            android:id="@+id/layoutLastDeposit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근 감지된 입금"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLastDeposit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="내역 없음"
                android:textColor="#E2E8F0"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 실시간 입금 감지 로그 창 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="실시간 감지 로그"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#020617"
            android:padding="12dp"
            android:textColor="#10B981"
            android:textSize="10.5sp"
            android:fontFamily="monospace"
            android:text="대기 중... 은행 입금 문자가 오면 자동으로 웹훅 전송됩니다.\n" />

    </LinearLayout>
    </ScrollView>

    <!-- Phase 3: AOD 올웨이즈 블랙 모드 오버레이 (OLED 번인 & 발열 방지) -->
    <FrameLayout
        android:id="@+id/layoutAod"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/containerAodContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <!-- 실시간 감지 상태 점 (초록 점) -->
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_badge_version"
                android:backgroundTint="#10B981"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvAodClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00"
                android:textColor="#334155"
                android:textSize="36sp"
                android:fontFamily="sans-serif-thin"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="SheetBot 24H 입금 감지 중"
                android:textColor="#1E293B"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="화면을 두 번 탭하면 복귀합니다"
                android:textColor="#1E293B"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
