<?xml version="1.0" encoding="utf-8"?>
<!-- 🛍️ 카드 마켓플레이스 (카드 스토어) 바텀시트 다이얼로그 (v2.2.0) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="16dp">

    <!-- 상단 드래그 핸들 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#334155"
        android:layout_marginBottom="12dp" />

    <!-- 헤더 타이틀 & 닫기 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛍️ 시트봇 카드 스토어"
            android:textColor="#38BDF8"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMarketplaceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_version"
            android:backgroundTint="#1E293B"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Beta"
            android:textColor="#F59E0B"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnCloseMarketplace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#94A3B8"
            android:textSize="18sp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="필요한 업무 자동화 카드를 골라 내 메인 대시보드에 자유롭게 설치하고 관리하세요."
        android:textColor="#94A3B8"
        android:textSize="11.5sp"
        android:layout_marginBottom="12dp" />

    <!-- 검색창 -->
    <EditText
        android:id="@+id/etMarketSearch"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#1E293B"
        android:paddingHorizontal="12dp"
        android:hint="🔍 카드 이름, 기능, 키워드 검색..."
        android:textColorHint="#64748B"
        android:textColor="#F8FAFC"
        android:textSize="12.5sp"
        android:singleLine="true"
        android:layout_marginBottom="10dp" />

    <!-- 카테고리 필터 탭 (가로 스크롤) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/layoutCategoryChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipCategoryAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_badge_version"
                android:backgroundTint="#0284C7"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="🌟 전체"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipCategoryStore"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_badge_version"
                android:backgroundTint="#1E293B"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="🏪 매장 · 정산"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipCategoryCrm"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_badge_version"
                android:backgroundTint="#1E293B"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="👥 고객 · 영업"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipCategoryAi"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_badge_version"
                android:backgroundTint="#1E293B"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="🤖 AI 자동화"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipCategoryExclusive"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_badge_version"
                android:backgroundTint="#1E293B"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="🔒 맞춤 전용"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 로딩 프로그레스바 -->
    <ProgressBar
        android:id="@+id/progressMarketLoading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:layout_marginVertical="24dp"
        android:visibility="gone" />

    <!-- 카드 목록 스크롤뷰 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutMarketCardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 동적으로 생성되는 카드 목록 아이템들 -->
        </LinearLayout>
    </ScrollView>

    <!-- 하단 기능 의뢰 안내 배너 -->
    <LinearLayout
        android:id="@+id/layoutMarketRequestFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E293B"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💡 찾는 기능이 없나요? 나만의 카드 맞춤 제작 의뢰하기"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="의뢰하기 ➔"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
