<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎁 친구/동료 초대"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_version"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="둘 다 +10,000T"
                android:textColor="#10B981"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="초대 링크로 동료가 앱을 설치하거나 구글 시트에 연동하면, 초대한 분과 동료 모두에게 10,000 토큰을 즉시 드립니다!"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="16dp" />

        <!-- 내 추천 코드 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="나의 고유 추천인 코드"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDialogMyCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LOADING..."
                    android:textColor="#34D399"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <Button
                    android:id="@+id/btnCopyMyCode"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#334155"
                    android:text="📋 코드 복사"
                    android:textColor="#38BDF8"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 카카오톡/문자 원터치 공유 버튼 -->
        <Button
            android:id="@+id/btnShareInvite"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#FEE500"
            android:text="💬 카카오톡 / 문자로 초대장 보내기"
            android:textColor="#191919"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <!-- 내 추천 실적 패널 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 나의 초대 리워드 현황"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvReferralStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="현재 0명 초대 완료 (누적 0 토큰 획득)"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 닫기 버튼 -->
        <Button
            android:id="@+id/btnCloseInviteDialog"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:backgroundTint="#1E293B"
            android:text="닫기"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
