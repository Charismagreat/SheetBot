<?xml version="1.0" encoding="utf-8"?>
<!-- ☑️ 시트 체크박스 문자 자동 발송 카드 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardSheetSmsCheckbox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_scenario"
    android:padding="13dp"
    android:layout_marginBottom="12dp">

    <!-- 상단 헤더 (타이틀 + 스위치 + 접기/펼치기) -->
    <LinearLayout
        android:id="@+id/layoutSheetSmsCheckboxHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="☑️ 시트 체크박스 문자 발송"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchSheetSmsCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnToggleSheetSmsCheckboxDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_version"
            android:backgroundTint="#0F172A"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="▲"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="구글 시트에서 체크박스 [V]를 누르면 스마트폰에서 고객에게 0원 문자가 즉시 자동 발송됩니다."
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="8dp" />

    <!-- 상세 설정 및 제어 영역 (접힘/펼침 제어) -->
    <LinearLayout
        android:id="@+id/layoutSheetSmsCheckboxDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334155"
            android:layout_marginVertical="6dp" />

        <!-- 가이드 박스 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 표준 시트 규격 (자동 연동)"
                android:textColor="#F8FAFC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• A열: 수신번호  |  B열: 고객명  |  C열: 문자 내용\n• D열: 발송 [V] (체크 시 발송)  |  E열: 발송결과 (자동)"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:layout_marginTop="3dp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- 감시 탭 이름 설정 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="감시 탭 이름:"
                android:textColor="#CBD5E1"
                android:textSize="11.5sp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etSheetSmsTargetTab"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="#0F172A"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:paddingHorizontal="10dp"
                android:hint="문자발송목록 (또는 시트1)"
                android:textColorHint="#64748B"
                android:singleLine="true" />
        </LinearLayout>

        <!-- 액션 버튼들 (1행: 시트 열기 & 탭 추가, 2행: 1초 테스트 발송) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnOpenSheetSmsSheet"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:backgroundTint="#0284C7"
                android:text="📊 연동 시트 열기 ›"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnAddSheetSmsTab"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="➕ 기존 시트에 탭 추가"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTestSheetSms"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:backgroundTint="#334155"
            android:text="🧪 1초 테스트 발송"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />
    </LinearLayout>
</LinearLayout>
