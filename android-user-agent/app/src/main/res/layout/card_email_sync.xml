<?xml version="1.0" encoding="utf-8"?>
<!-- 📧 수신 이메일(Gmail·네이버·다음·삼성·Outlook) 자동 기록 & 할 일 추출 카드 (JVM 255 파라미터 한계 방어 독립 레이아웃) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardEmailSync"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_scenario"
    android:padding="13dp"
    android:layout_marginBottom="12dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:id="@+id/layoutEmailSyncHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📧 수신 이메일 자동 기록 &amp; 할 일 추출"
            android:textColor="#60A5FA"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchEmailSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnToggleEmailSyncDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_version"
            android:backgroundTint="#0F172A"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="▲"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutEmailSyncSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0F172A"
        android:padding="10dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📬 지원 메일함: Gmail · 네이버 메일 · 다음 메일 · 삼성 이메일 · Outlook 전체 자동 감지"
            android:textColor="#38BDF8"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🛡️ 광고 · 뉴스레터 · 인증번호 메일 자동 제외"
                android:textColor="#E2E8F0"
                android:textSize="11.5sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEmailBlockSpam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎯 기록할 발신자 / 키워드 (비워두면 업무 메일 전체 기록):"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvEmailTargetCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_version"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="전체 기록"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnManageEmailTargets"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:backgroundTint="#334155"
            android:text="📋 등록 대상 확인 / 제외"
            android:textColor="#F1F5F9"
            android:textSize="11sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etEmailTargetFilter"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="#1E293B"
            android:paddingHorizontal="10dp"
            android:hint="쉼표(,)로 구분 (예: 견적, 발주, 세금계산서, 거래처명)"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <Button
                android:id="@+id/btnOpenEmailSheet"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:backgroundTint="#1E293B"
                android:text="📊 이메일 대장 ↗"
                android:textColor="#38BDF8"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnOpenEmailTasksHub"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:backgroundTint="#2563EB"
                android:text="✅ 할 일 허브 열기"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
