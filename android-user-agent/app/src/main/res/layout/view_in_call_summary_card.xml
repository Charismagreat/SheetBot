<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llFloatingRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_floating_overlay"
    android:elevation="12dp">

    <!-- 상단 바: 드래그 핸들, 타이틀, 접기/펼치기 및 닫기 버튼 -->
    <LinearLayout
        android:id="@+id/llHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📞"
            android:textSize="13sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SheetBot 인콜 브리핑"
            android:textColor="#38BDF8"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <!-- 접기/펼치기 토글 버튼 -->
        <TextView
            android:id="@+id/btnToggleExpand"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="▲"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="4dp" />

        <!-- 닫기 버튼 -->
        <TextView
            android:id="@+id/btnCloseFloating"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#EF4444"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- 고객 핵심 프로필 (상시 노출) -->
    <LinearLayout
        android:id="@+id/llCustomerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCustomerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="고객 정보 확인 중..."
                    android:textColor="#F8FAFC"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCustomerBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_version"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1.5dp"
                    android:text="시트 고객"
                    android:textColor="#38BDF8"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCustomerCompany"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시트 대장 조회 중..."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCallerPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="010-0000-0000"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- 로딩 프로그레스 바 -->
    <ProgressBar
        android:id="@+id/pbLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:layout_marginBottom="6dp" />

    <!-- 접힘/펼침 세부 정보 컨테이너 -->
    <LinearLayout
        android:id="@+id/llDetailContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 💡 직전 통화 AI 3줄 요약 카드 -->
        <LinearLayout
            android:id="@+id/llLastCallSummaryBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="9dp"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="3dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💡 직전 통화 핵심 요약"
                    android:textColor="#FACC15"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLastCallTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이전 통화 기록 없음"
                    android:textColor="#64748B"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLastCallSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="등록된 직전 통화 요약이 없습니다."
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <!-- 후속 할 일(Action Item) -->
            <TextView
                android:id="@+id/tvActionItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="후속 조치: -"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:layout_marginTop="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 📝 특이사항 및 메모 카드 -->
        <LinearLayout
            android:id="@+id/llCustomerMemoBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 특이사항 &amp; 시트 메모"
                android:textColor="#34D399"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tvCustomerMemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="등록된 특이사항 메모가 없습니다."
                android:textColor="#E2E8F0"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
