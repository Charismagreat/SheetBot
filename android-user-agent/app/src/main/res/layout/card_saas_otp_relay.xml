<?xml version="1.0" encoding="utf-8"?>
<!-- 🔐 내 SaaS 휴대폰 로그인 인증(OTP) 0원 중계기 카드 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardSaasOtpRelay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_scenario"
    android:padding="13dp"
    android:layout_marginBottom="12dp">

    <!-- 상단 헤더 (타이틀 + 스위치 + 접기/펼치기) -->
    <LinearLayout
        android:id="@+id/layoutSaasOtpRelayHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔐 내 SaaS 휴대폰 인증(OTP) 0원 중계기"
            android:textColor="#34D399"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchSaasOtpRelay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnToggleSaasOtpRelayDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_version"
            android:backgroundTint="#0F172A"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="▲"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="내가 만드는 SaaS 서비스에 휴대폰 번호 로그인을 1분 만에 연동하고, 내 폰 문자 요금제(0원)로 인증번호를 발송 및 대장에 자동 기록합니다."
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="8dp" />

    <!-- 상세 설정 및 제어 영역 -->
    <LinearLayout
        android:id="@+id/layoutSaasOtpRelayDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334155"
            android:layout_marginVertical="6dp" />

        <!-- 1. 서비스명(말머리) 및 일일 발송 한도 설정 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏷️ 서비스명(말머리):"
                android:textColor="#CBD5E1"
                android:textSize="11.5sp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/etSaasOtpBrandName"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="#0F172A"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:paddingHorizontal="10dp"
                android:hint="예: 마이SaaS"
                android:textColorHint="#64748B"
                android:singleLine="true"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="일일 한도:"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <EditText
                android:id="@+id/etSaasOtpDailyLimit"
                android:layout_width="54dp"
                android:layout_height="36dp"
                android:background="#0F172A"
                android:textColor="#38BDF8"
                android:textSize="11.5sp"
                android:gravity="center"
                android:inputType="number"
                android:text="150"
                android:singleLine="true" />
        </LinearLayout>

        <!-- 2. 전용 API Key 표시 및 복사/재발급 박스 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔑 내 SaaS 전용 OTP API Key"
                    android:textColor="#F8FAFC"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCopySaasOtpKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_version"
                    android:backgroundTint="#0284C7"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="📋 키 복사"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnRegenSaasOtpKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_version"
                    android:backgroundTint="#334155"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="🔄 재발급"
                    android:textColor="#CBD5E1"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSaasOtpApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="sbk_otp_..."
                android:textColor="#34D399"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• 발송 API: POST /api/saas/otp/send  |  검증 API: POST /api/saas/otp/verify\n• 동일 번호 60초 쿨다운 및 통신사 스팸 방지 일일 한도가 자동 보호됩니다."
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- 3. AI 코딩용 프롬프트 원터치 복사 버튼 -->
        <Button
            android:id="@+id/btnCopySaasOtpAiPrompt"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:backgroundTint="#4F46E5"
            android:text="🤖 AI 코딩용 휴대폰 로그인 연동 프롬프트 복사"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <!-- 4. 대장 열기 & 1초 발송/인증 테스트 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnOpenSaasOtpSheet"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:backgroundTint="#0284C7"
                android:text="📊 SaaS인증발송대장 ›"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnTestSaasOtp"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:backgroundTint="#059669"
                android:text="🧪 1초 발송·인증 테스트"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
