<?xml version="1.0" encoding="utf-8"?>
<!-- 🌟 시트봇 보관함 이동 완료 프리미엄 팝업 다이얼로그 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="20dp">

    <!-- 1. 상단 아이콘 및 타이틀 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📦"
            android:textSize="22sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="시트봇 보관함으로 이동 완료"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnArchiveDialogCloseTop"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#94A3B8"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 2. 보관된 카드 정보 하이라이트 박스 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E293B"
        android:padding="14dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tvArchivedCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 카드명"
            android:textColor="#F1F5F9"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="홈 화면에서 깔끔하게 숨겨졌습니다.\n화면 우측 엣지를 왼쪽(⬅️)으로 밀어 언제든 다시 꺼낼 수 있습니다."
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:lineSpacingMultiplier="1.2" />
    </LinearLayout>

    <!-- 3. 하단 액션 버튼 바 ([↺ 실행 취소] / [📦 보관함 열기]) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnArchiveUndo"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="#334155"
            android:text="↺ 실행 취소 (홈에 복원)"
            android:textColor="#38BDF8"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnArchiveOpenDrawer"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1.2"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="#7C3AED"
            android:text="📦 보관함 열어보기"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
