<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#450A0A"
    android:padding="24dp">

    <!-- 경고 헤더 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨"
        android:textSize="64sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvEmergencyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="웹사이트 다운타임 긴급 감지"
        android:textColor="#FEE2E2"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvEmergencyTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="감지 시각: 2026-09-28 01:50:00"
        android:textColor="#FCA5A5"
        android:textSize="13sp"
        android:layout_marginBottom="20dp" />

    <!-- 안내 카드 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#7F1D1D"
        android:padding="18dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvWebsiteTargetUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ https://your-website.com"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvWebsiteErrorDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="대상 웹사이트가 2회 연속 응답하지 않습니다.\n\n• 스마트폰 인터넷은 정상이며, 해당 사이트만 접속 불가함을 교차 검증했습니다.\n• 잠든 사이 발생한 서버 장애를 감지하여 비상 경보를 울립니다.\n• 신속히 호스팅 또는 서버 가동 상태를 점검하세요."
            android:textColor="#FECACA"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#991B1B"
            android:layout_marginVertical="12dp" />

        <TextView
            android:id="@+id/tvCrossCheckBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛡️ 휴대폰 인터넷 정상 (오탐 방지 교차 검증 완료)"
            android:textColor="#FDE047"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 제어 버튼들 -->
    <Button
        android:id="@+id/btnOpenWebsiteInBrowser"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:backgroundTint="#2563EB"
        android:text="🌐 내 사이트 브라우저로 접속 확인"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnEmergencyRetry"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="#DC2626"
        android:text="🔄 웹사이트 연결 지금 재점검"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnEmergencyDismiss"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#1F2937"
        android:text="🔕 비상 경보 끄기 및 닫기"
        android:textColor="#E5E7EB"
        android:textSize="14sp" />

</LinearLayout>
