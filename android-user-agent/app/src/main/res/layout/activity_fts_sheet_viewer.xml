<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <!-- 1. 상단 툴바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="11dp"
        android:background="#1E293B">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="⬅️"
            android:textSize="18sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvViewerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ 파일투시트 통합 워크스페이스"
                android:textColor="#F8FAFC"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvViewerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="전체 프로젝트 · 시트 열람 · 결재 · 파일 AI 적재"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 카드형 <-> 표 보기 전환 토글 -->
        <TextView
            android:id="@+id/btnToggleViewMode"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="📊 표 보기"
            android:textColor="#E2E8F0"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_version"
            android:backgroundTint="#334155"
            android:clickable="true"
            android:focusable="true" />

        <!-- 새로고침 -->
        <TextView
            android:id="@+id/btnRefreshSheet"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:text="🔄"
            android:textSize="15sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <!-- 파투 웹 열기 보조 버튼 -->
        <TextView
            android:id="@+id/btnOpenFtsWeb"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:paddingHorizontal="9dp"
            android:text="🌐 웹"
            android:textColor="#93C5FD"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_version"
            android:backgroundTint="#1E3A8A"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155" />

    <!-- 2-A. 1단: 전체 프로젝트 선택 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#111827"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingVertical="7dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="프로젝트:"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <HorizontalScrollView
            android:id="@+id/scrollProjectTabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutProjectTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E293B" />

    <!-- 2-B. 2단: 선택된 프로젝트의 하위 시트(대장) 탭 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#162032"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingVertical="7dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="시트:"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <HorizontalScrollView
            android:id="@+id/scrollSheetTabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutSheetTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 3. 검색바 + 파일/사진 적재 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:background="#0F172A">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_input_field">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etSearchRows"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="이름, 상호, 전화번호, 내용 검색..."
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="13sp"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <TextView
                android:id="@+id/btnClearSearch"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 📤 현재 시트에 사진/파일 등록 AI 적재 버튼 -->
        <TextView
            android:id="@+id/btnUploadToCurrentSheet"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="📤 +파일·행 적재"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_version"
            android:backgroundTint="#2563EB"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 4. 결재 상태 필터 바 (전체 / 대기 / 승인 / 보류 / 반려) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutApprovalFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chipFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingHorizontal="11dp"
                android:layout_marginEnd="6dp"
                android:text="전체 (0)"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_version"
                android:backgroundTint="#2563EB" />

            <TextView
                android:id="@+id/chipFilterPending"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingHorizontal="11dp"
                android:layout_marginEnd="6dp"
                android:text="⏳ 대기 (0)"
                android:textColor="#CBD5E1"
                android:textSize="11.5sp"
                android:background="@drawable/bg_badge_version"
                android:backgroundTint="#1E293B" />

            <TextView
                android:id="@+id/chipFilterApproved"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingHorizontal="11dp"
                android:layout_marginEnd="6dp"
                android:text="✅ 승인 (0)"
                android:textColor="#CBD5E1"
                android:textSize="11.5sp"
                android:background="@drawable/bg_badge_version"
                android:backgroundTint="#1E293B" />

            <TextView
                android:id="@+id/chipFilterHeld"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingHorizontal="11dp"
                android:layout_marginEnd="6dp"
                android:text="🟠 보류 (0)"
                android:textColor="#CBD5E1"
                android:textSize="11.5sp"
                android:background="@drawable/bg_badge_version"
                android:backgroundTint="#1E293B" />

            <TextView
                android:id="@+id/chipFilterRejected"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingHorizontal="11dp"
                android:layout_marginEnd="6dp"
                android:text="🚫 반려 (0)"
                android:textColor="#CBD5E1"
                android:textSize="11.5sp"
                android:background="@drawable/bg_badge_version"
                android:backgroundTint="#1E293B" />

            <TextView
                android:id="@+id/tvRowCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="0건 표시"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_version"
                android:backgroundTint="#0C4A6E" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 5. 카드 인라인 로딩 영역 (화면 뒤 스피너 없이 상단 카드형 로딩) -->
    <LinearLayout
        android:id="@+id/layoutViewerInlineLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:visibility="gone" />

    <!-- 6. 메인 컨텐츠 영역 (모바일 카드 리스트 뷰 / 표 보기 뷰 / 빈 상태 뷰) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- (A) 기본 모바일 카드형 리스트 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSheetCards"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp" />

        <!-- (B) 표(Table) 보기 모드 -->
        <ScrollView
            android:id="@+id/scrollTableVertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true">

                <TableLayout
                    android:id="@+id/tableSheetData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp" />
            </HorizontalScrollView>
        </ScrollView>

        <!-- (C) 데이터 없음 / 검색 결과 없음 안내 -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📭"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="적재된 데이터가 없습니다."
                android:textColor="#E2E8F0"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="우측 상단의 [📤 +파일·행 적재] 버튼을 눌러 사진 촬영이나 문서를 등록하면 AI가 시트 컬럼에 맞춰 자동 적재합니다."
                android:textColor="#94A3B8"
                android:textSize="12.5sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
